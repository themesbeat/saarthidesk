generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]
  workspaces    WorkspaceMember[]
  conversations Conversation[] @relation("AgentConversations")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  members       WorkspaceMember[]
  conversations Conversation[]
  leads         Lead[]
  knowledge     KnowledgeBase[]
  aiSettings    AiSettings?
  appointments  Appointment[]
  waitlist      WaitlistEntry[]
  campaigns     Campaign[]
  bookingRule   BookingRule?
  contacts      Contact[]
  channels      Channel[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt   DateTime @default(now())
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Conversation {
  id              String   @id @default(uuid())
  workspaceId     String
  platform        String   // WHATSAPP, INSTAGRAM, EMAIL, WEB
  status          String   @default("OPEN") // OPEN, RESOLVED, ARCHIVED
  contactId       String
  assignedAgentId String?
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  aiEnabled       Boolean  @default(true)
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAgent   User?     @relation("AgentConversations", fields: [assignedAgentId], references: [id])
  messages        Message[]
}

model Contact {
  id            String   @id @default(uuid())
  workspaceId   String?
  name          String?
  phone         String?
  email         String?
  avatar        String?
  tags          String[] @default([])
  customFields  Json     @default("{}")
  createdAt     DateTime @default(now())
  
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  lead          Lead?
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String
  sender            String   // USER, CUSTOMER, AI
  senderId          String?  // Links to User or Contact id
  messageType       String   @default("TEXT") // TEXT, MEDIA, INTERNAL_NOTE
  content           String
  attachments       Json     @default("[]") // e.g. [{type: "image", url: "..."}]
  metadata          Json     @default("{}") // for custom tracking data
  externalMessageId String?
  isAiGenerated     Boolean  @default(false)
  createdAt         DateTime @default(now())
  
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([externalMessageId])
}

model Channel {
  id           String    @id @default(uuid())
  workspaceId  String
  type         String    // WHATSAPP, TELEGRAM, EMAIL, INSTAGRAM, WEB
  credentials  Json      // Config settings/secrets/keys
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Lead {
  id          String   @id @default(uuid())
  workspaceId String
  contactId   String   @unique
  stage       String   @default("NEW") // NEW, INTERESTED, FOLLOW_UP, CONVERTED, CLOSED
  source      String?
  value       Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  content     String
  type        String   // TEXT, URL, PDF_TEXT
  createdAt   DateTime @default(now())
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AiSettings {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  tone        String   @default("PROFESSIONAL")
  autoReply   Boolean  @default(false)
  languages   String[] @default(["en"])
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime
}

model Appointment {
  id          String   @id @default(uuid())
  workspaceId String
  time        String   // e.g. "10:00 AM - 10:45 AM"
  staff       String   // e.g. "Dr. Sarah Miller"
  client      String   // e.g. "Ananya Sen"
  type        String   // e.g. "Patient Intake Session"
  status      String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  phone       String
  service     String
  priority    String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  createdAt   DateTime @default(now())
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Campaign {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  channel     String   // WhatsApp, SMS, Email, Telegram
  sent        Int      @default(0)
  delivered   Int      @default(0)
  openRate    Float    @default(0.0)
  replies     Int      @default(0)
  status      String   @default("DRAFT") // Completed, In Progress, Draft
  createdAt   DateTime @default(now())
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BookingRule {
  id            String   @id @default(uuid())
  workspaceId   String   @unique
  bufferTime    Int      @default(15)
  cancelWindow  Int      @default(24)
  reminder24h   Boolean  @default(true)
  reminder1h    Boolean  @default(true)
  
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
